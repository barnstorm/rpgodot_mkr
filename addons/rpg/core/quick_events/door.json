{
	"schema_version": 1,
	"name": "Door",
	"version": 1,
	"author": "RPG Kit",
	"description": "A door that opens, plays a sound and moves the player.",
	"asks": [
		{"key": "image", "type": "image", "res": "charset", "label": "Door image"},
		{"key": "destination", "type": "map_location", "label": "Where does it lead?"}
	],
	"event": {
		"name": "Door",
		"pages": [
			{
				"conditions": [],
				"graphic": {"sheet": "{{image.sheet}}", "index": "{{image.index}}", "facing": "down"},
				"priority": "same",
				"trigger": "action_button",
				"commands": [
					{"type": "play_sound", "sound": {"role": "door_open"}},
					{"type": "move_route", "target": "this", "wait": true, "steps": [
						{"turn": "left"}, {"wait": 0.05},
						{"turn": "right"}, {"wait": 0.05},
						{"turn": "up"}, {"through": true}
					]},
					{"type": "move_route", "target": "player", "wait": true, "skip_if_blocked": true, "steps": [
						{"step": "forward"}
					]},
					{"type": "transfer_player", "to": "{{destination}}", "facing": "keep", "fade": "black"}
				]
			}
		]
	}
}
