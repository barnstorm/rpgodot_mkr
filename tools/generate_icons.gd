	_add("confusion", "state", func() -> void:
		_shape(func(p: Vector2) -> bool:
			var v := p - V(16, 16)
			var r := v.length()
			var th := atan2(v.y, v.x)
			if th < 0.0:
				th += TAU
			for k in 3:
				var tt := th + TAU * k
				if tt > TAU * 2.4:
					break
				if absf(r - (1.5 + 1.0 * tt)) <= 1.45:
					return true
			return false, R.yellow, "radial"))
